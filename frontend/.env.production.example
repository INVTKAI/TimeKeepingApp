# Production-mode build values — used by `npm run build`.
#
# In CI / Netlify deploys these are set as build environment variables (Netlify
# project env + GitHub Actions secrets) and this file is unused. Copy this to
# .env.production locally only if you need to do a prod-mode build on your
# machine; the real .env.production is gitignored so values don't end up in git.
#
# The anon key is designed-public (RLS does the real access control) — but we
# still keep it out of git so rotation is simpler (only one place to update).

VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon JWT from Supabase Dashboard → Project Settings → API>
